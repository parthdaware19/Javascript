<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Inline + Internal + External (All in One)</title>

  <script>
    console.log("Internal JS: page is parsing...");

    document.addEventListener("DOMContentLoaded", () => {
      console.info("Internal JS: DOMContentLoaded fired.");

      console.group("Internal JS console demo");
      console.table([{ type: "internal", status: "ready" }]);
      console.groupEnd();
    });
  </script>

  <style>
    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f5f7fb;
      margin: 0;
      padding: 26px;
      color: #111827;
    }
    .card {
      max-width: 760px;
      margin: 0 auto;
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 14px;
      padding: 18px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.04);
    }
    h1 { margin: 0 0 14px; font-size: 20px; }
    .badge {
      display: inline-block;
      background: #eef2ff;
      color: #3730a3;
      border: 1px solid #c7d2fe;
      padding: 6px 10px;
      border-radius: 999px;
      font-size: 12px;
      margin-bottom: 10px;
    }
    label {
      display: block;
      font-size: 13px;
      margin: 10px 0 6px;
      color: #374151;
    }
    input, select {
      width: 100%;
      padding: 10px;
      border-radius: 10px;
      border: 1px solid #d1d5db;
      outline: none;
      box-sizing: border-box;
      background: #fff;
    }
    input:focus {
      border-color: #6366f1;
      box-shadow: 0 0 0 3px rgba(99,102,241,0.15);
    }
    .row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }
    .actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 14px;
      align-items: center;
    }
    button {
      padding: 10px 14px;
      border-radius: 10px;
      border: 0;
      cursor: pointer;
      font-weight: 700;
      background: #2563eb;
      color: #fff;
    }
    button:hover { background: #1d4ed8; }
    button.secondary { background: #111827; }
    button.secondary:hover { background: #0b1220; }
    .hint { font-size: 12px; color: #6b7280; margin-top: 10px; }
    .output {
      margin-top: 16px;
      padding: 14px;
      border-radius: 12px;
      border: 1px dashed #d1d5db;
      background: #fafafa;
      white-space: pre-wrap;
      min-height: 90px;
      font-size: 14px;
    }
    .small {
      font-size: 12px;
      color: #6b7280;
      margin-top: 6px;
    }
  </style>
</head>

<body>
  <div class="card">
    <div class="badge">Inline + Internal + “External” (inside same file) + Console Methods</div>
    <h1>User Info & Welcome Message</h1>

    <div class="row">
      <div>
        <label for="name">Name</label>
        <input id="name" type="text" placeholder="e.g., Alex"
               oninput="console.log('INLINE: name changed ->', this.value);" />
      </div>

      <div>
        <label for="email">Email</label>
        <input id="email" type="email" placeholder="e.g., alex@example.com"
               onblur="console.warn('INLINE: email field blurred');" />
      </div>
    </div>

    <div class="row">
      <div>
        <label for="role">Role</label>
        <select id="role"
                onchange="console.debug('INLINE: role updated ->', this.value);">
          <option value="">Select role</option>
          <option>Student</option>
          <option>Developer</option>
          <option>Designer</option>
          <option>Manager</option>
        </select>
      </div>

      <div>
        <label for="theme">Theme</label>
        <input id="theme" type="text" placeholder="e.g., Light / Dark"
               oninput="console.assert(true, 'INLINE: typing theme...');" />
      </div>
    </div>

    <div class="actions">
      <button id="btnWelcome"
        onclick="console.time('INLINE timer'); console.log('INLINE: welcome button clicked');">
        Show Welcome
      </button>

      <button class="secondary" onclick="console.clear(); console.log('INLINE: console cleared');">
        Clear Console
      </button>

      <div class="small">Tip: open DevTools → Console</div>
    </div>

    <div class="output" id="output">Welcome message will appear here...</div>
  </div>

  <script>
    (function externalLoaderDemo() {
      console.log("Setup: creating an external-like script...");

      const externalCode = `
        console.log("EXTERNAL-like JS: script executed (separate block).");

        const outputEl = document.getElementById("output");
        const btn = document.getElementById("btnWelcome");

        function renderWelcome() {
          console.info("EXTERNAL-like JS: generating welcome...");

          const name = document.getElementById("name").value.trim();
          const email = document.getElementById("email").value.trim();
          const role = document.getElementById("role").value.trim();
          const theme = document.getElementById("theme").value.trim();

          const user = { name, email, role, theme };

          console.warn("EXTERNAL-like JS: demo warning (not an error).");
          console.table([user]);

          if (!name) {
            outputEl.textContent = "Please enter your name.";
            console.error("EXTERNAL-like JS: validation failed (name missing).");
            return;
          }

          const safeRole = role || "Guest";
          const safeTheme = theme || "Default theme";

          outputEl.textContent =
            "Welcome, " + name + "!\\n" +
            "Role: " + safeRole + "\\n" +
            "Email: " + (email || "(not provided)") + "\\n" +
            "Theme: " + safeTheme + "\\n\\n" +
            "Have a great day!";

          console.group("EXTERNAL-like JS render done");
          console.assert(true, "EXTERNAL-like JS: assertion succeeded.");
          console.timeEnd("INLINE timer");
          console.groupEnd();
          console.log("EXTERNAL-like JS: welcome rendered.");
        }

        btn.addEventListener("click", renderWelcome);

        document.addEventListener("DOMContentLoaded", () => {
          console.debug("EXTERNAL-like JS: DOM is ready.");
        });
      `;

      const script = document.createElement("script");
      script.textContent = externalCode;
      document.body.appendChild(script);
    })();
  </script>
</body>
</html>
